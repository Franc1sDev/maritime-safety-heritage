# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# Public address of the API (for example https://api.example.org). Optional.
PUBLIC_API_URL=
# Comma-separated list of web origins allowed to call the API (the website, the app's dev server)
# Only needed for a website or app dev server on another address; the bundled website (served by this API) needs nothing here.
CORS_ORIGINS=

# PostgreSQL (your local PostgreSQL 18 during development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=maritime_heritage
DB_SSL=false

# Secrets: use long random values (at least 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-value
JWT_REFRESH_SECRET=change-me-to-another-long-random-value
MEDIA_SIGNING_SECRET=change-me-to-a-third-long-random-value
# Encrypts every stored media file. Back this key up somewhere safe: without it, the files cannot be read.
MEDIA_ENCRYPTION_KEY=change-me-to-a-fourth-long-random-value
MEDIA_ENCRYPT_AT_REST=true
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Media storage: "local" (folder on disk) or "s3" (Cloudflare R2, AWS S3, Backblaze B2, DigitalOcean Spaces...)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=500
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Virus scanning of every upload with ClamAV (clamd). The Docker setup includes it at clamav:3310.
# With CLAMAV_REQUIRED=true (the production default) uploads are refused while the scanner is unavailable.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false

# Storage alert: email ALERT_EMAILS when media passes 80% of this many GB (0 turns it off)
STORAGE_ALERT_GB=0
ALERT_EMAILS=

# Seed the first admin account (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@demo.ke
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_SAMPLE_DATA=true

# Sign-in cookie for the website. Keep "strict" when the website and API are on the same site.
COOKIE_SAMESITE=strict
# Set to true behind HTTPS (always in production)
COOKIE_SECURE=false
# true when running behind a reverse proxy or load balancer, so client IPs are logged correctly
TRUST_PROXY=false

# Email for password reset links. Leave SMTP_HOST empty in development: links are printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Maritime Safety Heritage Archive <no-reply@example.org>
# Address of the website, used in emailed links. With the bundled website this is the API address.
WEB_BASE_URL=http://localhost:4000
# The archive's official address, used for canonical links and the sitemap (for example https://maritimeheritage.or.ke)
SITE_URL=http://localhost:4000
# Public catalogue pages at /items (title and summary only) so search engines can find published items
PUBLIC_PREVIEWS=true

# Let people create their own researcher accounts (admins can always create accounts)
ALLOW_REGISTRATION=true
