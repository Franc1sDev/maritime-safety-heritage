# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# Public address of the API (for example https://api.example.org). Optional.
PUBLIC_API_URL=
# Comma-separated list of web origins allowed to call the API (the website, the app's dev server)
# Only needed for a website or app dev server on another address; the bundled website (served by this API) needs nothing here.
CORS_ORIGINS=

# PostgreSQL (your local PostgreSQL 18 during development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=maritime_heritage
DB_SSL=false

# Secrets: use long random values (at least 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-value
JWT_REFRESH_SECRET=change-me-to-another-long-random-value
MEDIA_SIGNING_SECRET=change-me-to-a-third-long-random-value
# Encrypts every stored media file. Back this key up somewhere safe: without it, the files cannot be read.
MEDIA_ENCRYPTION_KEY=change-me-to-a-fourth-long-random-value
MEDIA_ENCRYPT_AT_REST=true
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Media storage: "local" (folder on disk) or "s3" (Cloudflare R2, AWS S3, Backblaze B2, DigitalOcean Spaces...)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=200
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Virus scanning of every upload with ClamAV (clamd). The Docker setup includes it at clamav:3310.
# With CLAMAV_REQUIRED=true (the production default) uploads are refused while the scanner is unavailable.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false

# Storage alert: email ALERT_EMAILS when media passes 80% of this many GB (0 turns it off)
STORAGE_ALERT_GB=0
ALERT_EMAILS=

# Seed the first admin account (used by `npm run seed`)
SEED_ADMIN_EMAIL=super@demo.ke
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_SAMPLE_DATA=true

# Sign-in cookie for the website. Keep "strict" when the website and API are on the same site.
COOKIE_SAMESITE=strict
# Set to true behind HTTPS (always in production)
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (1 behind Caddy or nginx, 2 behind Cloudflare plus Caddy), so visitor addresses are logged correctly
TRUST_PROXY=false

# Email for password reset links. Leave SMTP_HOST empty in development: links are printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Maritime Safety Heritage Archive <no-reply@example.org>
# Address of the website, used in emailed links. With the bundled website this is the API address.
WEB_BASE_URL=http://localhost:4000
# The archive's official address, used for canonical links and the sitemap (for example https://maritimeheritage.or.ke)
SITE_URL=http://localhost:4000
# Public catalogue pages at /items (title and summary only) so search engines can find published items
PUBLIC_PREVIEWS=true


# ---------- Master plan settings ----------
# Sign in with Google and Apple (the only way Contributors sign in). See docs/DEPLOYMENT.md.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Local demo only: lets you sign in as a sample Contributor without Google or Apple. Ignored in production.
DEMO_SIGN_IN=true

# Redis: job queue, cache and live updates shared between copies of the API. Leave empty to run everything inside the API with a database queue.
REDIS_URL=
# Set to false on API-only copies when separate worker copies process the background jobs.
JOBS_WORKER=true

# AI services. AI_PROVIDER: anthropic, openai, gemini, rules (built-in stand-in for testing) or none (everything waits for an admin).
AI_PROVIDER=rules
AI_API_KEY=
AI_MODEL=
AI_SMALL_MODEL=
AI_DAILY_LIMIT=2000
# Speech to text for transcripts and captions (OpenAI-compatible key). Leave empty to switch transcription off.
AI_TRANSCRIBE_KEY=

# Push notifications. FCM_SERVICE_ACCOUNT is the Firebase service account JSON on one line (Android and iOS).
FCM_SERVICE_ACCOUNT=
# Web push keys: create a pair with  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# SMS sign-in codes for admins (Africa's Talking). Leave empty to use the authenticator app and email codes only.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Approvals: majority (two-thirds of active admins, with a deadline after which a Super Admin decides) or all.
APPROVAL_RULE=majority
APPROVAL_DEADLINE_DAYS=7

# Upload limits per file type, in MB, and the longest video in minutes.
MAX_VIDEO_MB=200
MAX_VIDEO_MINUTES=5
MAX_AUDIO_MB=100
MAX_IMAGE_MB=25
MAX_DOCUMENT_MB=25

MINIMUM_AGE=18
MIN_APP_VERSION=2.0.0
NEW_ACCOUNT_DAILY_STORIES=5
REPORT_ESCALATE_HOURS=48
REMOVED_STORY_RETENTION_DAYS=365

# Human check on the forms open to visitors (Cloudflare Turnstile). Leave empty to rely on rate limits and the trap field.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Google Maps key for the browser ("Where It Happened" and Map Explore).
GOOGLE_MAPS_BROWSER_KEY=
# Shown under stories that involve loss. Leave empty for the default text.
SUPPORT_INFO=
