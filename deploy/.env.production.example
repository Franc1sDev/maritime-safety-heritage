# Production settings. Copy to deploy/.env on the server and fill in every value.
# Generate each secret with:  openssl rand -base64 48
# Never commit the real .env.

# The archive's official domain (DNS A record pointing to this server), without https://
SITE_DOMAIN=archive.example.org

NODE_ENV=production
DB_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
MEDIA_SIGNING_SECRET=
# Encrypts every stored media file. Keep a copy in a password manager: without it the files cannot be read.
MEDIA_ENCRYPTION_KEY=

# First admin, created on the first start only. Remove the password from this file after you sign in and change it.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SAMPLE_DATA=false

# Media storage: "local" keeps files on this server (backed up below); "s3" uses cloud object storage.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=500

# Email (password reset links, review results, alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Maritime Safety Heritage Archive <no-reply@archive.example.org>

# Alerts
ALERT_EMAILS=
STORAGE_ALERT_GB=100

# Search engines: public catalogue pages with titles and summaries at /items
PUBLIC_PREVIEWS=true
ALLOW_REGISTRATION=true
CLAMAV_REQUIRED=true

# Backups: AES-256 encrypted, daily at BACKUP_HOUR, kept for BACKUP_KEEP_DAYS days.
BACKUP_PASSPHRASE=
BACKUP_HOUR=02
BACKUP_KEEP_DAYS=14
# Off-site copy with rclone (configure the remote with "rclone config" and mount its config), for example r2:maritime-backups
BACKUP_RCLONE_REMOTE=
